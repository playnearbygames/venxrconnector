# ---- App ----
PORT=3000
# Public URL of this app (no trailing slash). Used for OAuth redirects and the MCP links shown to users.
BASE_URL=http://localhost:3000
NODE_ENV=development

# ---- Database (any Postgres 13+) ----
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (or direct connection).
# Later you can point this at any other Postgres; nothing in the app is Supabase-specific.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venxr
# require | disable  (Supabase needs "require"; local Postgres usually "disable")
DATABASE_SSL=disable

# 32 random bytes, base64. Encrypts stored OAuth tokens + MCP links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Comma-separated emails that can open /admin (all users' tool-call usage)
ADMIN_EMAILS=

# ---- Meta (developers.facebook.com -> your app -> Facebook Login + Marketing API) ----
# Valid OAuth redirect URI to whitelist: {BASE_URL}/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
# business_management lets us also find ad accounts owned by / shared with the user's Business Managers.
META_SCOPES=ads_read,business_management
# Only for Business-type apps using "Facebook Login for Business": the Configuration ID
# (Facebook Login for Business -> Configurations). When set, META_SCOPES is ignored.
META_CONFIG_ID=
# Login screen: business.facebook.com = "Log in to Business Tools from Meta" (Facebook + Managed Meta Account).
# Use www.facebook.com for the plain Facebook login screen.
META_LOGIN_HOST=business.facebook.com

# ---- Google (console.cloud.google.com -> OAuth client "Web application") ----
# Off for now: Meta-only launch. Set to true to show Google on the site and expose google_ads_get_campaigns.
ENABLE_GOOGLE=false
# Authorized redirect URI to whitelist: {BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads -> Admin (manager account) -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v26
